# Copy to .env and fill in. Never commit .env.

# Gemini API key. Used through LangChain, not Google's SDK.
GEMINI_API_KEY=

# Tavily web search key. TRAVILY_API_KEY is also accepted.
TAVILY_API_KEY=

# SQLite file. Docker Compose sets this to a mounted volume; leave it alone
# unless you are running the backend outside a container.
DATABASE_PATH=/data/pantrypal.db

# Model tiers. Overridable so a model rename does not require a code change.
# Free-tier daily caps are per model id. The classifier and the fast tier share
# one id, so they share one allowance; only the smart tier has its own. The
# backup is therefore only a real fallback for the smart tier. Noted in
# TRADEOFFS.md rather than papered over.
MODEL_CLASSIFIER=gemini-3.1-flash-lite
MODEL_FAST=gemini-3.1-flash-lite
MODEL_SMART=gemini-3.5-flash-lite
MODEL_BACKUP=gemini-3.1-flash-lite
