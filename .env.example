# Copy to .env and fill in. Never commit .env.

# Gemini API key. Used through LangChain, not Google's SDK.
GEMINI_API_KEY=

# Tavily web search key. TRAVILY_API_KEY is also accepted.
TAVILY_API_KEY=

# Postgres connection. This default matches the docker-compose service and
# needs no changes for local runs.
DATABASE_URL=postgresql://pantrypal:pantrypal@postgres:5432/pantrypal

# Model tiers. Overridable so a model rename does not require a code change.
MODEL_FAST=gemini-2.5-flash
MODEL_SMART=gemini-2.5-pro
